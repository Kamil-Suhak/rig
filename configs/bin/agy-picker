#!/usr/bin/env python3
"""Rofi conversation picker for Antigravity CLI ('agy') sessions."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import urllib.parse
from pathlib import Path


_MENTION_TAG_RE = re.compile(r"@\[[^\]]+\]")
_CONV_MENTION_RE = re.compile(r'@\[conversation:"([^"]+)"\]')


def _format_label(title: str | None, preview: str | None, cid: str) -> str:
    raw_title = _MENTION_TAG_RE.sub("", (title or "")).strip()
    if raw_title:
        return " ".join(raw_title.split())[:72]
    first_line = ((preview or "").strip().splitlines() or [""])[0]
    cleaned_preview = _MENTION_TAG_RE.sub("", first_line).strip()
    if cleaned_preview:
        return " ".join(cleaned_preview.split())[:72]
    m = _CONV_MENTION_RE.search(first_line)
    if m and m.group(1).strip():
        return " ".join(m.group(1).split())[:72]
    return cid[:8]


def _parse_workspace_dir(raw_uris: str, fallback: Path) -> Path:
    try:
        uris = json.loads(raw_uris or "[]")
    except ValueError:
        uris = []
    if isinstance(uris, list) and uris:
        first = str(uris[0])
        if first.startswith("file://"):
            parsed = Path(urllib.parse.unquote(urllib.parse.urlparse(first).path))
            if parsed.is_dir():
                return parsed
        else:
            cand = Path(first)
            if cand.is_dir():
                return cand
    return fallback


def load_conversations(cli_dir: Path, *, limit: int = 50, source: str = "main") -> list[dict[str, str]]:
    """Load top-level agy CLI conversations from conversation_summaries.db."""
    db_path = cli_dir / "conversation_summaries.db"
    if not db_path.is_file():
        return []

    home = Path.home()
    rows: list[dict[str, str]] = []
    con: sqlite3.Connection | None = None
    try:
        con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=2.0)
        cur = con.execute(
            """
            SELECT conversation_id, title, preview, workspace_uris, last_modified_time
            FROM conversation_summaries
            WHERE parent_conversation_id = '' AND step_count > 0
            ORDER BY last_modified_time DESC
            LIMIT ?
            """,
            (limit,),
        )
        for cid, title, preview, raw_uris, mtime in cur.fetchall():
            if not (cli_dir / "conversations" / f"{cid}.db").is_file():
                continue
            label = _format_label(title, preview, str(cid))
            cwd = _parse_workspace_dir(str(raw_uris), home)
            ws_name = "~" if cwd == home else cwd.name
            short_date = str(mtime)[:16].replace("T", " ")
            prefix = "[ask] " if source == "ask" else ""
            rows.append(
                {
                    "id": str(cid),
                    "cwd": str(cwd),
                    "source": source,
                    "mtime": str(mtime),
                    "display": f"{prefix}{label}  [{ws_name}]  ({short_date})",
                }
            )
    finally:
        if con is not None:
            con.close()
    return rows


def _launch_session(cid: str, cwd: str, source: str, ask_home: Path, *, dry_run: bool = False) -> int:
    if cid == "__new__":
        agy_tail = ["agy"]
    else:
        agy_tail = ["agy", "--conversation", cid]

    if source == "ask":
        cmd = ["ghostty", f"--working-directory={cwd}", "-e", "env", f"HOME={ask_home}", *agy_tail]
    else:
        cmd = ["ghostty", f"--working-directory={cwd}", "-e", *agy_tail]

    if dry_run:
        print(" ".join(cmd))
        return 0

    subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="agy-picker", description="Pick an agy CLI conversation via rofi (tabbed agy | ask modes) and launch it in Ghostty.")
    parser.add_argument("--ask", action="store_true", help="Target isolated ask-home rolling sessions")
    parser.add_argument("--rofi-mode", action="store_true", help="Run as a native Rofi script mode")
    parser.add_argument("--list", action="store_true", help="Print formatted conversation entries and exit")
    parser.add_argument("--dry-run", action="store_true", help="Print the selected launch command instead of executing")
    parser.add_argument("--limit", type=int, default=50, help="Maximum conversations to show (default: 50)")
    parser.add_argument("selection", nargs="?", help=argparse.SUPPRESS)
    args = parser.parse_args(argv)

    ask_home = Path(os.environ.get("RIG_ASK_HOME") or (Path.home() / ".local" / "share" / "ask-home")).expanduser()
    ask_cli_dir = ask_home / ".gemini" / "antigravity-cli"
    main_cli_dir = Path(os.environ.get("RIG_AGY_CLI_DIR") or (Path.home() / ".gemini" / "antigravity-cli")).expanduser()

    source = "ask" if args.ask else "main"
    cli_dir = ask_cli_dir if args.ask else main_cli_dir
    prompt_label = "ask" if args.ask else "agy"
    empty_msg = "No ask sessions found." if args.ask else "No Antigravity CLI conversations found."

    if args.rofi_mode:
        if args.selection is not None:
            info = os.environ.get("ROFI_INFO", "").strip()
            parts = info.split("\t")
            if len(parts) >= 3:
                return _launch_session(parts[0], parts[1], parts[2], ask_home, dry_run=args.dry_run)
            return 0
        print(f"\x00prompt\x1f{prompt_label}> ")
        print(f"[NEW] Start new session\x00info\x1f__new__\t{Path.home()}\t{source}")
        for item in load_conversations(cli_dir, limit=args.limit, source=source):
            display = item["display"].removeprefix("[ask] ")
            print(f"{display}\x00info\x1f{item['id']}\t{item['cwd']}\t{source}")
        return 0

    if args.list:
        items = load_conversations(cli_dir, limit=args.limit, source=source)
        if not items:
            print(empty_msg, file=sys.stderr)
            return 1
        for item in items:
            print(f"{item['id']}\t{item['cwd']}\t{item['display']}")
        return 0

    toggle_script = Path.home() / ".config" / "hypr" / "scripts" / "rofi-toggle.sh"
    rofi = str(toggle_script) if toggle_script.is_file() else shutil.which("rofi")
    if not rofi:
        print("✖ agy-picker: 'rofi' not found in PATH.", file=sys.stderr)
        return 1

    self_path = str(Path(__file__).resolve())
    initial_mode = "ask" if args.ask else "agy"
    modi = f"agy:{self_path} --rofi-mode,ask:{self_path} --rofi-mode --ask"
    cmd = [
        rofi,
        "-show",
        initial_mode,
        "-modi",
        modi,
        "-i",
        "-theme-str",
        "window { width: 820px; }",
    ]
    if args.dry_run:
        print(" ".join(cmd))
        return 0

    return subprocess.run(cmd, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
