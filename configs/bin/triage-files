#!/usr/bin/env python3
"""Auto-sort Downloads and Screenshots using deterministic rules + Gemini Decisions API."""

from __future__ import annotations

import argparse
import base64
import json
import mimetypes
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _rig_common import call_gemini_decisions, ctext  # noqa: E402

DEFAULT_ENDPOINT = "https://generativelanguage.googleapis.com/v1beta/decisions"
MAX_MULTIMODAL_BYTES = 50 * 1024 * 1024
PARTIAL_SUFFIXES = {".part", ".crdownload", ".tmp", ".download"}

EXTENSION_BUCKETS = {
    ".iso": "installers",
    ".img": "installers",
    ".appimage": "installers",
    ".exe": "installers",
    ".msi": "installers",
    ".deb": "installers",
    ".rpm": "installers",
    ".zst": "archives",
    ".zip": "archives",
    ".7z": "archives",
    ".rar": "archives",
    ".tar": "archives",
    ".gz": "archives",
    ".xz": "archives",
    ".bz2": "archives",
}

DECIDE_BUCKETS = ["code", "ui", "memes", "docs", "trash", "unsorted"]
MULTIMODAL_MIMES = {
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".webp": "image/webp",
    ".pdf": "application/pdf",
}
TEXT_EXTS = {".txt", ".md", ".csv", ".json", ".log"}


def _unique_dest(dest_dir: Path, filename: str) -> Path:
    candidate = dest_dir / filename
    if not candidate.exists():
        return candidate
    stem = Path(filename).stem
    suffix = Path(filename).suffix
    idx = 1
    while True:
        alt = dest_dir / f"{stem}_{idx}{suffix}"
        if not alt.exists():
            return alt
        idx += 1


def _build_item_parts(path: Path) -> list[dict[str, object]] | None:
    ext = path.suffix.lower()
    size = path.stat().st_size
    if size > MAX_MULTIMODAL_BYTES:
        return None
    mime = MULTIMODAL_MIMES.get(ext) or mimetypes.guess_type(str(path))[0]
    if ext in MULTIMODAL_MIMES and mime:
        b64 = base64.b64encode(path.read_bytes()).decode("ascii")
        item_type = "image" if mime.startswith("image/") else "document"
        return [
            {"type": "text", "text": f"File: {path.name}"},
            {"type": item_type, "data": b64, "mime_type": mime},
        ]
    if ext in TEXT_EXTS:
        snippet = path.read_text(encoding="utf-8", errors="replace")[:2000]
        return [{"type": "text", "text": f"File: {path.name}\n\n{snippet}"}]
    return None


def _call_decide_batch(paths: list[Path], api_key: str, *, dry_run: bool = False) -> dict[Path, tuple[str, float]]:
    input_parts: list[dict[str, object]] = []
    questions: dict[str, dict[str, object]] = {}
    key_map: dict[str, Path] = {}
    results: dict[Path, tuple[str, float]] = {}

    for idx, p in enumerate(paths):
        parts = _build_item_parts(p)
        if not parts:
            results[p] = ("unsorted", 0.0)
            continue
        qkey = f"file_{idx}"
        key_map[qkey] = p
        input_parts.append({"type": "text", "text": f"[{qkey}]"})
        input_parts.extend(parts)
        questions[qkey] = {
            "type": "choice",
            "instructions": (
                f"Classify {qkey} ({p.name}) into one mutually exclusive bucket: "
                "code (terminals, IDEs, code snippets, errors), "
                "ui (desktop ricing, window managers, app UI/design), "
                "memes (humor, stream/video frames, social/chat), "
                "docs (receipts, invoices, PDFs, notes, articles), "
                "trash (throwaway one-off crops, accidental screenshots, temp clutter), "
                "or unsorted (ambiguous)."
            ),
            "criteria": {b: f"Bucket: {b}" for b in DECIDE_BUCKETS},
        }

    if not questions:
        return results

    body = call_gemini_decisions(input_parts, questions, api_key=api_key, dry_run=dry_run, timeout=30.0)

    answers = body.get("answers") or {}
    for qkey, p in key_map.items():
        verdict = answers.get(qkey) or {}
        decision = str(verdict.get("choice") or verdict.get("decision") or "unsorted").strip().lower()
        try:
            conf = float(verdict.get("confidence", verdict.get("score", 0.0)))
        except (TypeError, ValueError):
            conf = 0.0
        results[p] = (decision, conf)
    return results


def triage_directory(
    directory: Path,
    *,
    min_age: int,
    min_confidence: float,
    batch_size: int,
    dry_run: bool,
    api_key: str,
) -> list[str]:
    if not directory.is_dir():
        return []

    now = time.time()
    actions: list[str] = []
    decide_queue: list[Path] = []

    def _move_file(entry: Path, bucket: str, reason: str) -> None:
        dest_dir = directory / bucket
        dest = _unique_dest(dest_dir, entry.name)
        if dry_run:
            actions.append(f"[DRY-RUN] {entry.name} -> {bucket}/{dest.name} ({reason})")
        else:
            dest_dir.mkdir(parents=True, exist_ok=True)
            shutil.move(str(entry), str(dest))
            actions.append(f"[MOVED] {entry.name} -> {bucket}/{dest.name} ({reason})")

    for entry in sorted(directory.iterdir(), key=lambda p: p.name.lower()):
        if not entry.is_file() or entry.name.startswith("."):
            continue
        if entry.suffix.lower() in PARTIAL_SUFFIXES:
            continue
        try:
            age = now - entry.stat().st_mtime
        except OSError:
            continue
        if age < min_age:
            continue

        ext_bucket = EXTENSION_BUCKETS.get(entry.suffix.lower())
        if ext_bucket:
            _move_file(entry, ext_bucket, "extension")
        elif api_key:
            decide_queue.append(entry)

    for i in range(0, len(decide_queue), max(1, batch_size)):
        batch = decide_queue[i : i + max(1, batch_size)]
        try:
            verdicts = _call_decide_batch(batch, api_key, dry_run=dry_run)
        except (OSError, RuntimeError, urllib.error.URLError, ValueError) as exc:
            actions.append(f"[WARN] batch ({len(batch)} file(s)): decide failed ({exc})")
            continue
        for entry in batch:
            decision, conf = verdicts.get(entry, ("unsorted", 0.0))
            if dry_run and decision == "dry-run":
                _move_file(entry, "dry-run", "validated via call_gemini_decisions")
            elif decision == "unsorted" or decision not in DECIDE_BUCKETS or conf < min_confidence:
                _move_file(entry, "ambiguous", f"low-conf {decision} ({conf:.2f} < {min_confidence:.2f})")
            else:
                _move_file(entry, decision, f"decide conf={conf:.2f}")
    return actions


def install_systemd_timer() -> int:
    unit_dir = Path.home() / ".config" / "systemd" / "user"
    unit_dir.mkdir(parents=True, exist_ok=True)
    script_path = Path(__file__).resolve()
    py = sys.executable

    service_text = (
        "[Unit]\n"
        "Description=Triage Downloads and Screenshots via rig decide\n\n"
        "[Service]\n"
        "Type=oneshot\n"
        f"EnvironmentFile=-%h/.config/rig/triage.env\n"
        f"ExecStart={py} {script_path}\n"
    )
    timer_text = (
        "[Unit]\n"
        "Description=Run rig file triage every 10 minutes\n\n"
        "[Timer]\n"
        "OnBootSec=2min\n"
        "OnUnitActiveSec=10min\n"
        "Persistent=true\n\n"
        "[Install]\n"
        "WantedBy=timers.target\n"
    )
    (unit_dir / "rig-triage.service").write_text(service_text, encoding="utf-8")
    (unit_dir / "rig-triage.timer").write_text(timer_text, encoding="utf-8")
    print(ctext(f"[APPLIED] Wrote systemd user units in {unit_dir}", "green"))
    if shutil.which("systemctl"):
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        subprocess.run(["systemctl", "--user", "enable", "--now", "rig-triage.timer"], check=False)
        print(ctext("[APPLIED] Enabled and started rig-triage.timer", "green"))
        print(ctext("Note: put GEMINI_API_KEY=... in ~/.config/rig/triage.env for timer runs.", "darkgray"))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="triage-files",
        description="Auto-sort Downloads and Screenshots using extension rules + Gemini Decisions API.",
    )
    parser.add_argument("--dir", action="append", dest="dirs", help="Directory to triage (repeatable; defaults to ~/Downloads and ~/Pictures/Screenshots)")
    parser.add_argument("--min-age", type=int, default=60, help="Skip files modified more recently than N seconds (default: 60)")
    parser.add_argument("--min-confidence", type=float, default=0.70, help="Minimum decide confidence to move a file (default: 0.70)")
    parser.add_argument("--batch-size", type=int, default=5, help="Max files per decide API batch (default: 5)")
    parser.add_argument("--dry-run", action="store_true", help="Preview moves without modifying files")
    parser.add_argument("--install-timer", action="store_true", help="Install and enable systemd --user timer (rig-triage.timer)")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.install_timer:
        return install_systemd_timer()

    dirs = [Path(d).expanduser() for d in args.dirs] if args.dirs else [
        Path.home() / "Downloads",
        Path.home() / "Pictures" / "Screenshots",
    ]
    api_key = os.environ.get("GEMINI_API_KEY", "").strip()
    if not api_key:
        print(ctext("[INFO] GEMINI_API_KEY not set; running extension-only routing.", "yellow"))

    total = 0
    for d in dirs:
        for line in triage_directory(
            d,
            min_age=args.min_age,
            min_confidence=args.min_confidence,
            batch_size=args.batch_size,
            dry_run=args.dry_run,
            api_key=api_key,
        ):
            print(line)
            total += 1
    if total == 0:
        print("No eligible files to triage.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
