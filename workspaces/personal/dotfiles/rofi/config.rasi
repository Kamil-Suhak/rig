configuration {
    modi: "drun,window,workset:~/code/projects/rig/configs/bin/workset-picker --rofi-mode,run";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 15";
    click-to-exit: true;
    drun-display-format: "{name}";
    window-format: "{w}  {c}  ·  {t}";
    kb-element-next: "";
    kb-element-prev: "";
    kb-mode-next: "Tab";
    kb-mode-previous: "ISO_Left_Tab";
}

* {
    bg: rgba(40, 44, 52, 0.90);
    bg-alt: rgba(33, 37, 43, 0.75);
    fg: #abb2bf;
    accent: #61afef;
    gold: #e5c07b;
    border-col: rgba(97, 175, 239, 0.27);
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 620px;
    background-color: @bg;
    border: 1px;
    border-color: @border-col;
    border-radius: 10px;
    padding: 16px;
}

mainbox {
    spacing: 12px;
    children: [inputbar, listview, mode-switcher];
}

mode-switcher {
    spacing: 8px;
}

button {
    padding: 6px 12px;
    border-radius: 6px;
    background-color: @bg-alt;
    text-color: #5c6370;
    horizontal-align: 0.5;
}

button selected {
    background-color: @accent;
    text-color: #282c34;
}

inputbar {
    spacing: 8px;
    padding: 8px 12px;
    background-color: @bg-alt;
    border-radius: 6px;
    children: [prompt, entry];
}

prompt {
    text-color: @gold;
}

entry {
    placeholder: "Search...";
    placeholder-color: #5c6370;
    text-color: #e6edf3;
}

listview {
    lines: 12;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 6px 10px;
    border-radius: 6px;
    spacing: 10px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: #282c34;
}

element-icon {
    size: 22px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
