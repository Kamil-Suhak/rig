[
  {
    "output": "eDP-1",
    "layer": "bottom",
    "position": "top",
    "height": 30,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "bluetooth", "network", "custom/power-mode", "battery", "tray"],
    "hyprland/window": {
      "format": "{title}",
      "max-length": 45,
      "separate-outputs": true
    },
    "custom/power-mode": {
      "exec": "~/.config/hypr/scripts/power-mode.sh status",
      "return-type": "json",
      "interval": 10,
      "signal": 8,
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh power"
    },
    "bluetooth": {
      "format": "󰂯",
      "format-connected": "󰂱 {device_alias}",
      "format-off": "󰂲",
      "tooltip-format": "{controller_alias}\t{status}",
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh bluetooth"
    },
    "hyprland/workspaces": {
      "format": "{id}",
      "on-click": "activate",
      "sort-by-number": true
    },
    "clock": {
      "format": "{:%a %d %b  %H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>"
    },
    "pulseaudio": {
      "format": "󰕾 {volume}%",
      "format-muted": "󰖁 muted",
      "on-click": "pavucontrol",
      "scroll-step": 5
    },
    "network": {
      "format-wifi": "󰤨 {essid}",
      "format-ethernet": "󰈀 {ifname}",
      "format-disconnected": "󰤭 offline",
      "tooltip-format": "{ipaddr}/{cidr} ({signalStrength}%)",
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh wifi"
    },
    "battery": {
      "states": { "warning": 25, "critical": 12 },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "tray": { "icon-size": 15, "spacing": 8 }
  },
  {
    "output": "HDMI-A-1",
    "name": "external",
    "layer": "bottom",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "bluetooth", "network", "custom/power-mode", "battery", "tray"],
    "hyprland/window": {
      "format": "{title}",
      "max-length": 45,
      "separate-outputs": true
    },
    "custom/power-mode": {
      "exec": "~/.config/hypr/scripts/power-mode.sh status",
      "return-type": "json",
      "interval": 10,
      "signal": 8,
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh power"
    },
    "bluetooth": {
      "format": "󰂯",
      "format-connected": "󰂱 {device_alias}",
      "format-off": "󰂲",
      "tooltip-format": "{controller_alias}\t{status}",
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh bluetooth"
    },
    "hyprland/workspaces": {
      "format": "{id}",
      "on-click": "activate",
      "sort-by-number": true
    },
    "clock": {
      "format": "{:%a %d %b  %H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>"
    },
    "pulseaudio": {
      "format": "󰕾 {volume}%",
      "format-muted": "󰖁 muted",
      "on-click": "pavucontrol",
      "scroll-step": 5
    },
    "network": {
      "format-wifi": "󰤨 {essid}",
      "format-ethernet": "󰈀 {ifname}",
      "format-disconnected": "󰤭 offline",
      "tooltip-format": "{ipaddr}/{cidr} ({signalStrength}%)",
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh wifi"
    },
    "battery": {
      "states": { "warning": 25, "critical": 12 },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "tray": { "icon-size": 16, "spacing": 8 }
  }
]
