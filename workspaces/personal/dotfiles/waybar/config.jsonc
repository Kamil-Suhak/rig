[
  {
    "output": "eDP-1",
    "layer": "bottom",
    "position": "top",
    "height": 30,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["idle_inhibitor", "pulseaudio", "bluetooth", "network", "battery", "tray"],
    "hyprland/window": {
      "format": "{title}",
      "max-length": 45,
      "separate-outputs": true
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
      "tooltip": true,
      "tooltip-format-activated": "Keep awake: ON",
      "tooltip-format-deactivated": "Keep awake: OFF"
    },
    "bluetooth": {
      "format": "󰂯",
      "format-connected": "󰂱 {device_alias}",
      "format-off": "󰂲",
      "tooltip-format": "{controller_alias}\t{status}",
      "on-click": "ghostty --class=com.bluetui.float -e bluetui"
    },
    "hyprland/workspaces": {
      "format": "{id}",
      "on-click": "activate",
      "sort-by-number": true
    },
    "clock": {
      "format": "{:%a %d %b  %H:%M}",
      "tooltip": false,
      "on-click": "pkill -x waycal || waycal"
    },
    "pulseaudio": {
      "format": "󰕾 {volume}%",
      "format-muted": "󰖁 muted",
      "on-click": "pavucontrol",
      "scroll-step": 5
    },
    "network": {
      "format-wifi": "󰤨 {essid}",
      "format-ethernet": "󰈀 {ifname}",
      "format-disconnected": "󰤭 offline",
      "tooltip-format": "{ipaddr}/{cidr} ({signalStrength}%)",
      "on-click": "networkmanager_dmenu"
    },
    "battery": {
      "states": { "warning": 25, "critical": 12 },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "tray": { "icon-size": 15, "spacing": 8 }
  },
  {
    "output": "HDMI-A-1",
    "name": "external",
    "layer": "bottom",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["idle_inhibitor", "pulseaudio", "bluetooth", "network", "battery", "tray"],
    "hyprland/window": {
      "format": "{title}",
      "max-length": 45,
      "separate-outputs": true
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
      "tooltip": true,
      "tooltip-format-activated": "Keep awake: ON (sleep and lock paused)",
      "tooltip-format-deactivated": "Keep awake: OFF (normal sleep and lock)"
    },
    "bluetooth": {
      "format": "󰂯",
      "format-connected": "󰂱 {device_alias}",
      "format-off": "󰂲",
      "tooltip-format": "{controller_alias}\t{status}",
      "on-click": "ghostty --class=com.bluetui.float -e bluetui"
    },
    "hyprland/workspaces": {
      "format": "{id}",
      "on-click": "activate",
      "sort-by-number": true
    },
    "clock": {
      "format": "{:%a %d %b  %H:%M}",
      "tooltip": false,
      "on-click": "pkill -x waycal || waycal"
    },
    "pulseaudio": {
      "format": "󰕾 {volume}%",
      "format-muted": "󰖁 muted",
      "on-click": "pavucontrol",
      "scroll-step": 5
    },
    "network": {
      "format-wifi": "󰤨 {essid}",
      "format-ethernet": "󰈀 {ifname}",
      "format-disconnected": "󰤭 offline",
      "tooltip-format": "{ipaddr}/{cidr} ({signalStrength}%)",
      "on-click": "networkmanager_dmenu"
    },
    "battery": {
      "states": { "warning": 25, "critical": 12 },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "tray": { "icon-size": 16, "spacing": 8 }
  }
]
