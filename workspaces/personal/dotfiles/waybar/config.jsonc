[
  {
    "output": "eDP-1",
    "layer": "bottom",
    "position": "top",
    "height": 32,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["bluetooth", "network", "pulseaudio", "custom/power-mode", "custom/sep", "battery", "tray"],
    "hyprland/window": {
      "format": "{title}",
      "max-length": 45,
      "separate-outputs": true
    },
    "custom/sep": {
      "format": "│",
      "tooltip": false
    },
    "custom/power-mode": {
      "exec": "~/.config/hypr/scripts/power-mode.sh status-icon",
      "return-type": "json",
      "interval": 10,
      "signal": 8,
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh power"
    },
    "bluetooth": {
      "format": "󰂯",
      "format-connected": "󰂱",
      "format-off": "󰂲",
      "tooltip-format": "{controller_alias}\t{status}\n{num_connections} connected",
      "tooltip-format-connected": "{controller_alias}\t{status}\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias} ({device_battery_percentage}%)",
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh bluetooth"
    },
    "hyprland/workspaces": {
      "format": "{id}",
      "on-click": "activate",
      "sort-by-number": true
    },
    "clock": {
      "format": "󰥔  {:%a %d %b  %H:%M}",
      "tooltip": false
    },
    "pulseaudio": {
      "format": "{icon}",
      "format-muted": "󰖁",
      "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"]
      },
      "tooltip-format": "{desc}\nVolume: {volume}%",
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh audio",
      "scroll-step": 5
    },
    "network": {
      "format-wifi": "{icon}",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰤭",
      "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
      "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}\nGW: {gwaddr}",
      "tooltip-format-ethernet": "Wired ({ifname})\n{ipaddr}/{cidr}\nGW: {gwaddr}",
      "tooltip-format-disconnected": "Disconnected — click to manage networks",
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh wifi"
    },
    "battery": {
      "states": { "warning": 25, "critical": 12 },
      "format": "{icon}",
      "format-charging": "󰂄",
      "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
      "tooltip-format": "{capacity}% · {timeTo}"
    },
    "tray": { "icon-size": 15, "spacing": 8 }
  },
  {
    "output": "HDMI-A-1",
    "name": "external",
    "layer": "bottom",
    "position": "top",
    "height": 36,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["bluetooth", "network", "pulseaudio", "custom/power-mode", "custom/sep", "battery", "tray"],
    "hyprland/window": {
      "format": "{title}",
      "max-length": 45,
      "separate-outputs": true
    },
    "custom/sep": {
      "format": "│",
      "tooltip": false
    },
    "custom/power-mode": {
      "exec": "~/.config/hypr/scripts/power-mode.sh status",
      "return-type": "json",
      "interval": 10,
      "signal": 8,
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh power"
    },
    "bluetooth": {
      "format": "󰂯",
      "format-connected": "󰂱 {device_alias}",
      "format-off": "󰂲",
      "tooltip-format": "{controller_alias}\t{status}\n{num_connections} connected",
      "tooltip-format-connected": "{controller_alias}\t{status}\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias} ({device_battery_percentage}%)",
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh bluetooth"
    },
    "hyprland/workspaces": {
      "format": "{id}",
      "on-click": "activate",
      "sort-by-number": true
    },
    "clock": {
      "format": "󰥔  {:%a %d %b  %H:%M}",
      "tooltip": false
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰖁 muted",
      "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"]
      },
      "tooltip-format": "{desc}\nVolume: {volume}%",
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh audio",
      "scroll-step": 5
    },
    "network": {
      "format-wifi": "{icon} {essid}",
      "format-ethernet": "󰈀 {ifname}",
      "format-disconnected": "󰤭 Offline",
      "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
      "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}\nGW: {gwaddr}",
      "tooltip-format-ethernet": "Wired ({ifname})\n{ipaddr}/{cidr}\nGW: {gwaddr}",
      "tooltip-format-disconnected": "Disconnected — click to manage networks",
      "on-click": "~/.config/hypr/scripts/waybar-menu.sh wifi"
    },
    "battery": {
      "states": { "warning": 25, "critical": 12 },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
      "tooltip-format": "{capacity}% · {timeTo}"
    },
    "tray": { "icon-size": 16, "spacing": 8 }
  }
]
